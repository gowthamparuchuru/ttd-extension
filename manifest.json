{
  "manifest_version": 3,
  "name": "TTD Pilgrim Autofill",
  "version": "1.0.0",
  "description": "Save pilgrim, Srivani and Srivari Seva details once and autofill them into TTD booking forms.",
  "minimum_chrome_version": "111",
  "browser_specific_settings": {
    "gecko": {
      "id": "ttd-pilgrim-autofill@local",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "TTD Pilgrim Autofill",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": ["storage", "unlimitedStorage", "activeTab"],
  "host_permissions": ["https://ttdevasthanams.ap.gov.in/*", "https://tirupatibalaji.ap.gov.in/*"],
  "content_scripts": [
    {
      "matches": [
        "https://ttdevasthanams.ap.gov.in/*",
        "https://tirupatibalaji.ap.gov.in/*"
      ],
      "js": ["content/pageworld.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://ttdevasthanams.ap.gov.in/*",
        "https://tirupatibalaji.ap.gov.in/*"
      ],
      "js": [
        "content/core.js",
        "content/pilgrim.js",
        "content/srivani.js",
        "content/seva.js",
        "content/main.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/icon-128.png"],
      "matches": [
        "https://ttdevasthanams.ap.gov.in/*",
        "https://tirupatibalaji.ap.gov.in/*"
      ]
    }
  ]
}
